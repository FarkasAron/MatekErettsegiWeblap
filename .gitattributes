# Normalise line endings: store text as LF in the repo, check out LF on every
# platform. Stops the "LF will be replaced by CRLF" churn on Windows checkouts.
* text=auto eol=lf

# Explicit binary types — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
