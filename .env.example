# ─────────────────────────────────────────────────────────────────────────────
# Matematika Feladatbank — environment variable template
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
#   - The Next.js web app reads `.env.local` (and `.env`) automatically.
#   - The Python pipeline scripts (scripts/*.py) read `.env.local` specifically
#     (hard-coded path: <repo>/.env.local).
#
# `.env`, `.env.local` and `.env.*.local` are git-ignored. Never commit real
# secrets. This `.env.example` file IS committed and must stay placeholder-only.
# ─────────────────────────────────────────────────────────────────────────────


# ── Web app — REQUIRED ───────────────────────────────────────────────────────
# PostgreSQL connection string for the self-hosted database.
#
# The database is a self-hosted PostgreSQL 14 instance running in an LXC
# container on the Proxmox host, reachable on the LAN at 192.168.0.52:5432
# (a separate LXC runs the Next.js app). The project migrated here from Supabase.
# In local development the dev machine reaches it over the LAN/VPN; problem
# images are proxied to http://192.168.0.52/images/... by next.config.mjs.
#
# Consumed by: src/lib/db.ts (pg Pool), scripts/run_matma_import.py
# Format:      postgresql://<user>:<password>@<host>:5432/<database>
# Current deploy uses: host 192.168.0.52, port 5432, database
#   `matek_erettsegi_web`, user `postgres`. Password: recover from the Next.js
#   LXC's env file / PM2 config (it is not stored in this repo).
DATABASE_URL=postgresql://postgres:PASSWORD@192.168.0.52:5432/matek_erettsegi_web


# ── Pipeline scripts — AI topic categorisation — OPTIONAL ────────────────────
# Anthropic API key (starts with "sk-ant-"). Only needed to run the automatic
# topic-tagging scripts; the website does not use it.
#
# Consumed by: scripts/08_claude_categorize.py, scripts/categorize_matma_local.py
ANTHROPIC_API_KEY=


# ── LEGACY — Supabase — OPTIONAL (pre-migration) ────────────────────────────
# The app no longer uses Supabase (replaced by the self-hosted PostgreSQL above).
# These variables are still referenced by the older pipeline scripts 06/07/08/09,
# which have not yet been ported to direct PostgreSQL (MIGRATION_GUIDE.md step 16).
# Set them only if you still operate the old Supabase project.
#
# Consumed by: scripts/06_import_to_db.py, scripts/07_review_app.py,
#              scripts/08_claude_categorize.py, scripts/09_extract_answers.py
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
